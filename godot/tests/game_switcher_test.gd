extends SceneTree
func _initialize() -> void: call_deferred("_run")
func _run() -> void:
 var manager_script=load("res://scripts/mod_manager.gd")
 assert(manager_script!=null)
 var args=PackedStringArray(["--path","/tmp/project","--","--game=bfme1","--max-fps=60","--bfme1-install=/tmp/assets"])
 var changed=manager_script.restart_arguments(args,"bfme2")
 assert(changed.count("--game=bfme2")==1 and not changed.has("--game=bfme1"))
 assert(changed.has("--max-fps=60") and changed.has("--bfme1-install=/tmp/assets"))
 changed=manager_script.restart_arguments(changed,"bfme1")
 assert(changed.count("--game=bfme1")==1 and not changed.has("--game=bfme2"))
 assert(manager_script.restart_arguments(PackedStringArray(),"bfme1")==PackedStringArray(["--","--game=bfme1"]))
 changed=manager_script.restart_arguments(args,"bfme1","/tmp/new assets")
 assert(changed.has("--bfme1-install=/tmp/new assets") and not changed.has("--bfme1-install=/tmp/assets"))
 var current=manager_script.current_restart_arguments("bfme2")
 for arg in OS.get_cmdline_user_args():
  if not arg.begins_with("--game="):assert(current.has(arg),"Lost player argument: "+arg)
 var manager=manager_script.new()
 root.add_child(manager)
 await process_frame
 assert(manager._game_picker.item_count==2)
 manager._game_picker.item_selected.emit(1)
 assert(manager._game=="bfme1")
 manager._game_picker.item_selected.emit(0)
 assert(manager._game=="bfme2")
 print("GAME SWITCHER PASS: BFME1 and RotWK, argument preservation, selector")
 manager.queue_free()
 quit()
