extends SceneTree
# Needs the local optional wall pack generated by tools/import_109_mordor_walls.py.
func _initialize() -> void: call_deferred('_run')
func _run() -> void:
 var fs=ClassDB.instantiate('RetailFileSystem')
 assert(fs.mount_retail().ok)
 var world=ClassDB.instantiate('GameWorld');root.add_child(world)
 assert(world.setup(fs).ok)
 assert(world.load_map('map mp fall back 4p',{'slots':[{'player':'Player_1','faction':'FactionMordor','human':true}]}).ok)
 var owner=world.execute_lua("for id,p in pairs(bfme.players) do if p.name=='Player_1' then p.money=100000; return id end end")
 assert(owner.ok)
 var names=['MordorCastleWallHubOuter','MordorCastleWallSegment','MordorCastleWallGate','MordorWallTowerSmall','MordorWallCatapultSmall']
 var ids=[]
 for i in names.size():
  var id=world.create_object(names[i],int(owner.output),1500+i*200,1800,0)
  # tolerance: Runtime object IDs are allocated dynamically; zero denotes creation failure.
  assert(id!=0)
  ids.append(id)
  assert(not world.get_template_model(names[i]).is_empty())
 assert(not world.get_template_model('MordorWallCatapult').is_empty())
 var camera=Camera3D.new();root.add_child(camera)
 var hud=ClassDB.instantiate('InGameHudNode');root.add_child(hud)
 assert(hud.setup(fs,world,camera,'Player_1',{'camera_start':Vector3(1900,0,-1800),'alternate_mouse':true}).ok)
 hud.set_controller_layout(true)
 hud.select_controller_group(PackedInt64Array([ids[0]]))
 world.advance(.2)
 for i in 4: await process_frame
 var span={}
 for command in hud.get_command_buttons():
  if command.get('template','')=='MordorCastleWallHubOuterContinues': span=command
 assert(not span.is_empty(),str(hud.get_command_buttons()))
 assert(hud.activate_command(span.slot,span.in_palantir,false))
 hud.inject_mouse_move(hud.world_to_pixel(Vector2(2100,1800)))
 for i in 6: await process_frame
 var preview=hud.get_placement_ghost_state()
 assert(not preview.get('icons',[]).is_empty(),str(preview))
 var construction=world.execute_lua("local p=bfme.players.localPlayer; local site=assert(p:findBuildSite('MordorWallCatapultSmall',{x=2500,y=1800},1000)); mordorWallTest=p:construct('MordorWallCatapultSmall',site,100)")
 assert(construction.ok,str(construction))
 world.update_lua()
 for i in 100: world.advance(.2)
 world.update_lua()
 var status=world.execute_lua("return bfme.mutations.getStatus(mordorWallTest)")
 assert(status.ok and str(status.output).strip_edges()=='complete',str(status))
 var mounted_catapult=false
 for id in world.get_object_ids():
  if world.get_object(id).get('template','')=='MordorWallCatapult': mounted_catapult=true
 assert(mounted_catapult,'Wall emplacement must spawn its catapult')
 hud.select_controller_group(PackedInt64Array())
 var porter=world.create_object('MordorPorter',int(owner.output),1400,1700,0)
 hud.select_controller_group(PackedInt64Array([porter]))
 world.advance(.2)
 for i in 4: await process_frame
 var builds_hub=false
 for command in hud.get_command_buttons():
  if command.get('template','')=='MordorCastleWallHubOuter': builds_hub=true
 assert(builds_hub,'Mordor builder must offer the new wall hub')
 for id in ids: assert(world.build2_damage(id,10000000))
 for i in 2: world.advance(.2)
 var hub=world.create_object('MordorCastleWallHubOuter',int(owner.output),1800,1800,0)
 assert(world.build2_wall_span(hub,'MordorCastleWallHubOuterContinues',1800,1800,2200,1800,0))
 for i in 180: world.advance(.2)
 var segments=0
 for id in world.get_object_ids():
  var object=world.get_object(id)
  if str(object.get('template','')).begins_with('MordorCastleWallSegment'): segments+=1
 # tolerance: A four-hundred-unit span must create interior pieces; tessellation controls the exact count.
 assert(segments>0)
 print('MORDOR WALLS TEST PASS')
 hud.free();world.free();quit(0)
