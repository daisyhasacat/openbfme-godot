extends SceneTree
func _initialize() -> void: call_deferred("run")
func run() -> void:
	var release = root.get_node("Release")
	assert(release.selected_game() == "aotr")
	var base := "/tmp/openbfme-aotr-selection-%s" % OS.get_process_id()
	var folder := base.path_join("AotR/aotr")
	DirAccess.make_dir_recursive_absolute(folder.path_join("data"))
	var marker := folder.path_join("AOTRSkirmish.big")
	var file := FileAccess.open(marker, FileAccess.WRITE)
	file.store_string("test marker")
	file.close()
	assert(release.aotr_folder(base) == folder)
	assert(release.aotr_folder(base.path_join("AotR")) == folder)
	assert(release.aotr_folder(folder) == folder)
	assert(release.aotr_folder(base.path_join("absent")) == "")
	var manager = load("res://scripts/mod_manager.gd").new()
	root.add_child(manager)
	assert(manager._game_picker.item_count == 3)
	assert(manager._game_picker.selected == 2)
	assert(manager._game == "aotr")
	var args = manager.restart_arguments(PackedStringArray(["--", "--game=bfme2", "--aotr-install=old"]), "aotr", "", folder)
	assert(args == PackedStringArray(["--", "--game=aotr", "--aotr-install=" + folder]))
	manager.free()
	DirAccess.remove_absolute(marker)
	DirAccess.remove_absolute(folder.path_join("data"))
	DirAccess.remove_absolute(folder)
	DirAccess.remove_absolute(base.path_join("AotR"))
	DirAccess.remove_absolute(base)
	print("AOTR SELECTION PASS")
	quit()
