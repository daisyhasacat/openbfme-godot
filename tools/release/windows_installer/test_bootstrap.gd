extends SceneTree
func _initialize() -> void:
 var script = load(get_script().resource_path.get_base_dir().path_join("content_bootstrap.gd"))
 assert(script != null)
 var root := OS.get_environment("TMPDIR").path_join("openbfme-bootstrap-fixture-" + str(OS.get_process_id()))
 var settings := root.path_join("settings")
 for folder in ["content/rotwk", "content/bfme2", "content/mods/000", "content/installed-maps/Test Map"]:
  assert(DirAccess.make_dir_recursive_absolute(root.path_join(folder)) == OK)
 var profile := FileAccess.open(root.path_join("content-profile.json"), FileAccess.WRITE)
 profile.store_string(JSON.stringify({"game":"bfme2", "hd_textures":false,"mods":[{"path":"content/mods/000","textures_only":false}]}))
 profile.close()
 var map := FileAccess.open(root.path_join("content/installed-maps/Test Map/fixture.txt"),FileAccess.WRITE)
 map.store_string("authored fixture");map.close()
 assert(script.configure(root, settings) == "")
 assert(OS.get_environment("ROTWK_INSTALL") == root.path_join("content/rotwk"))
 var config := ConfigFile.new()
 assert(config.load(settings.path_join("mods.cfg")) == OK)
 assert(config.get_value("mods","enabled") == [root.path_join("content/mods/000")])
 assert(FileAccess.get_file_as_string(settings.path_join("installed-maps/Test Map/fixture.txt")) == "authored fixture")
 config.set_value("mods","enabled",[]);assert(config.save(settings.path_join("mods.cfg"))==OK)
 assert(script.configure(root, settings) == "")
 assert(config.load(settings.path_join("mods.cfg")) == OK)
 assert(config.get_value("mods","enabled").is_empty())
 assert(script.configure(root.path_join("missing"),settings) == "Missing or invalid installed content profile.")
 var bfme2_profile := FileAccess.open(root.path_join("content-profile.json"), FileAccess.WRITE)
 bfme2_profile.store_string(JSON.stringify({"game":"bfme2-106","hd_textures":false,"mods":[],"installs":["bfme2"]}))
 bfme2_profile.close()
 assert(DirAccess.remove_absolute(root.path_join("content/rotwk")) == OK)
 assert(DirAccess.remove_absolute(settings.path_join("bundle-root.txt")) == OK)
 assert(script.configure(root,settings) == "")
 assert(OS.get_environment("ROTWK_INSTALL").is_empty())
 assert(config.load(settings.path_join("game-selection.cfg")) == OK)
 assert(config.get_value("game","selected") == "bfme2-106")
 print("Windows content bootstrap: PASS (paths, active mods, maps, preserved settings, missing content)")
 quit()
