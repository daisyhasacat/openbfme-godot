## the icon's image; null when the text does not decode to the 256 x 256 PNG (a damaged script)
static func image() -> Image:
	var img := Image.new()
	if img.load_png_from_buffer(Marshalls.base64_to_raw(PNG_BASE64)) != OK or img.get_width() != SIZE or img.get_height() != SIZE:
		return null
	return img


## sets the window icon; "" when done, else why not (the caller reports it). A headless run has no window: nothing to set
static func apply() -> String:
	if DisplayServer.get_name() == "headless":
		return ""
	var img := image()
	if img == null:
		return "app_icon.gd: the icon does not decode"
	DisplayServer.set_icon(img)
	return ""
