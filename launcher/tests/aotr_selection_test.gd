extends SceneTree
const Updater = preload("res://scripts/core/updater.gd")
const BuildInfo = preload("res://scripts/core/build_info.gd")
const Paths = preload("res://scripts/ui/paths.gd")
func _initialize() -> void:
	var base := "/tmp/openbfme-aotr-launch-%s" % OS.get_process_id()
	var folder := base.path_join("AotR/aotr")
	DirAccess.make_dir_recursive_absolute(folder.path_join("data"))
	var file := FileAccess.open(folder.path_join("AOTRSkirmish.big"), FileAccess.WRITE)
	file.store_string("test marker")
	file.close()
	var previous := OS.get_environment("AOTR_INSTALL")
	OS.set_environment("AOTR_INSTALL", base)
	assert(Paths.aotr_folder(base) == folder)
	var updater = Updater.new(BuildInfo.load_info())
	updater.data_dir = base
	updater.set_state("launcher", "game", "aotr")
	var launch: Dictionary = updater.game_arguments()
	assert(launch.ok)
	assert(launch.args == PackedStringArray(["--", "--game=aotr", "--aotr-install=" + folder]))
	assert(not updater.game_arguments(PackedStringArray(["--online-join=test"])).ok)
	OS.set_environment("AOTR_INSTALL", previous)
	print("AOTR LAUNCHER SELECTION PASS")
	quit()
